"flowchart TD\n    classDef startEnd fill:#0A121A,stroke:#0A121A,stroke-width:2px,color:#FFF;\n    classDef userAction fill:#1D384D,stroke:#132635,stroke-width:2px,color:#FFF;\n    classDef sysProcess fill:#132635,stroke:#0A121A,stroke-width:2px,color:#FFF;\n    classDef decision fill:#00A896,stroke:#028090,stroke-width:2px,color:#FFF;\n    classDef errorModal fill:#8B261D,stroke:#6B1D16,stroke-width:2px,color:#FFF;\n\n    START([\"● 시작: 랜딩 접속 (사단 AI 센트 랩)\"]) :::startEnd\n    \n    START --> MAIN[\"P-MAIN-01: 메인 홈 탐색\"] :::userAction\n    \n    MAIN --> INTRO[\"P-INTRO-01: AI 기술 소개 & 만족도 지표\"] :::userAction\n    MAIN --> DIAG[\"P-DIAG-01: 1분 AI 취향 진단 진입\"] :::userAction\n    MAIN --> CHAT[\"P-CHAT-01: 실시간 대화형 챗봇 상담\"] :::userAction\n    MAIN --> KIT[\"P-KIT-01: AI 맞춤 3종 샘플 신청\"] :::userAction\n\n    DIAG --> QUIZ[\"P-DIAG-01-01: 1분 퀴즈 폼 작성 (기분/TPO)\"] :::userAction\n    QUIZ --> REPORT[\"P-DIAG-01-02: AI 분석 결과 보고서 팝업\"] :::userAction\n    REPORT --> KIT_FORM[\"P-KIT-01-01: 샘플 배송 신청 폼 작성\"] :::userAction\n    CHAT --> KIT_FORM\n    KIT --> KIT_FORM\n\n    KIT_FORM --> VALIDATE{\"주소 & 연락처 유효성 검사\"} :::decision\n\n    VALIDATE -- Fail (오류) --> ERR_MSG[\"에러 표시 & 주소 재입력 유도\"] :::errorModal\n    ERR_MSG --> KIT_FORM\n\n    VALIDATE -- Pass (성공) --> SYS_SAVE[\"시스템: AI 3종 샘플 신청 DB 저장\"] :::sysProcess\n    SYS_SAVE --> API_TALK[\"시스템: 카카오 알림톡 확정 발송\"] :::sysProcess\n    \n    API_TALK --> CONFIRM_PAGE[\"P-KIT-01-02: 샘플 신청 완료 & 배송 안내\"] :::userAction\n    \n    CONFIRM_PAGE --> END_EVENT([\"● 종료: AI 맞춤 3종 퍼퓸 샘플 배송 시작\"]) :::startEnd\n"
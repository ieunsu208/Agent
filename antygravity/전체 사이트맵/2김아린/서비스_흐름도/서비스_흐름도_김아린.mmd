"flowchart TD\n    classDef startEnd fill:#3E2A1D,stroke:#3E2A1D,stroke-width:2px,color:#FFF;\n    classDef userAction fill:#8B6B4D,stroke:#6E533B,stroke-width:2px,color:#FFF;\n    classDef sysProcess fill:#5A3E2B,stroke:#3E2A1D,stroke-width:2px,color:#FFF;\n    classDef decision fill:#D97724,stroke:#B05C15,stroke-width:2px,color:#FFF;\n    classDef errorModal fill:#A8422B,stroke:#82311E,stroke-width:2px,color:#FFF;\n\n    START([\"● 시작: 랜딩 접속 (사단 웰니스)\"]) :::startEnd\n    \n    START --> MAIN[\"P-MAIN-01: 메인 홈 탐색\"] :::userAction\n    \n    MAIN --> PHIL[\"P-PHIL-01: 브랜드 힐링 철학 감상\"] :::userAction\n    MAIN --> TEST[\"P-TEST-01: 공간 향 매칭 테스트 시작\"] :::userAction\n    MAIN --> DEV[\"P-DEV-01: 스마트 디퓨저 & 임상 확인\"] :::userAction\n    MAIN --> KIT_POP[\"P-KIT-01-01: 4종 시향 캡슐 무료 신청\"] :::userAction\n\n    TEST --> QUIZ[\"P-TEST-01-01: 1분 공간 퀴즈 (침실/서재/거실)\"] :::userAction\n    QUIZ --> RESULT[\"P-TEST-01-02: 맞춤 아로마 레시피 추천\"] :::userAction\n\n    RESULT --> CLICK_SUB{\"[이 레시피로 정기구독] 클릭?\"} :::decision\n    DEV --> CLICK_SUB\n    MAIN --> CLICK_SUB\n\n    CLICK_SUB -- Yes --> SUB_FORM[\"P-SUB-01-01: 정기구독 신청 폼 작성\"] :::userAction\n    CLICK_SUB -- No --> MAIN\n\n    SUB_FORM --> VALIDATE{\"입력값 유효성 검사 (이름/연락처/배송지)\"} :::decision\n    \n    VALIDATE -- Fail (오류) --> ERR_MSG[\"에러 메시지 노출 및 재입력 유도\"] :::errorModal\n    ERR_MSG --> SUB_FORM\n\n    VALIDATE -- Pass (성공) --> SYS_SAVE[\"시스템: 구독 신청 정보 DB 저장 및 카드 자동등록\"] :::sysProcess\n    SYS_SAVE --> API_TALK[\"시스템: 카카오 알림톡 확정 메시지 발송\"] :::sysProcess\n    \n    API_TALK --> CONFIRM_PAGE[\"P-SUB-01-02: 정기구독 완료 & 배송 일정 안내\"] :::userAction\n    \n    CONFIRM_PAGE --> END_EVENT([\"● 종료: 정기 배송 및 디바이스 연동 준비 완료\"

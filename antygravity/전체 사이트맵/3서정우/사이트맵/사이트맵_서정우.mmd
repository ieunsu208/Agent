"flowchart TD\n    classDef main fill:#3B2A1E,stroke:#251B13,stroke-width:2px,color:#FFF;\n    classDef primary fill:#6B4E38,stroke:#4E3827,stroke-width:2px,color:#FFF;\n    classDef modal fill:#C89D5C,stroke:#9E793B,stroke-width:2px,color:#000;\n    classDef util fill:#E0D4C5,stroke:#6B4E38,stroke-width:1px,color:#2A1F18;\n\n    ROOT[\"[Root] 사단 커스텀 아틀리에 (서정우)\"] :::main\n    \n    ROOT --> P_MAIN[\"1.0 메인 홈\\n(P-MAIN-01)\"] :::primary\n    \n    P_MAIN --> P_CUST[\"2.0 3D 커스텀 시뮬레이터\\n(P-CUST-01)\"] :::primary\n    P_MAIN --> P_CRAFT[\"3.0 장인 공방 스토리\\n(P-CRAFT-01)\"] :::primary\n    P_MAIN --> P_B2B[\"4.0 B2B 기업 기프트\\n(P-B2B-01)\"] :::primary\n    P_MAIN --> P_PKG[\"5.0 선물 포장 안내\\n(P-PKG-01)\"] :::primary\n    P_MAIN --> P_B2B_MODAL[\"4.1 B2B 대량 견적 신청 모달\\n(P-B2B-01-01)\"] :::modal\n    P_MAIN --> P_SYS[\"6.0 시스템 & 약관\\n(P-SYS-01)\"] :::util\n\n    P_CUST --> P_CUST_UI[\"2.1 3D 실시간 커스텀 UI\\n(P-CUST-01-01)\"] :::primary\n    P_CUST_UI --> P_CUST_FORM[\"2.2 커스텀 완성 & 주문 폼\\n(P-CUST-01-02)\"] :::modal\n    P_CUST_FORM --> P_B2B_DONE[\"4.2 견적/주문 완료 팝업 [가정]\\n(P-B2B-01-02)\"] :::modal\n\n    P_B2B --> P_B2B_MODAL\n    P_B2B_MODAL --> P_B2B_DONE\n"
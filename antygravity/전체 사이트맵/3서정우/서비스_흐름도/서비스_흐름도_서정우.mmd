"flowchart TD\n    classDef startEnd fill:#251B13,stroke:#251B13,stroke-width:2px,color:#FFF;\n    classDef userAction fill:#6B4E38,stroke:#4E3827,stroke-width:2px,color:#FFF;\n    classDef sysProcess fill:#3B2A1E,stroke:#251B13,stroke-width:2px,color:#FFF;\n    classDef decision fill:#C89D5C,stroke:#9E793B,stroke-width:2px,color:#000;\n    classDef errorModal fill:#8B261D,stroke:#6B1D16,stroke-width:2px,color:#FFF;\n\n    START([\"● 시작: 랜딩 접속 (사단 아틀리에)\"]) :::startEnd\n    \n    START --> MAIN[\"P-MAIN-01: 메인 홈 탐색\"] :::userAction\n    \n    MAIN --> CUST[\"P-CUST-01: 3D 커스텀 시뮬레이터 진입\"] :::userAction\n    MAIN --> CRAFT[\"P-CRAFT-01: 장인 공방 비하인드 감상\"] :::userAction\n    MAIN --> B2B_PAGE[\"P-B2B-01: B2B 기업 기프트 제안 확인\"] :::userAction\n\n    CUST --> CUST_UI[\"P-CUST-01-01: 3D 실시간 가죽/각인 조합\"] :::userAction\n    CUST_UI --> CHECK_QTY{\"주문 수량 >= 50개?\"} :::decision\n\n    CHECK_QTY -- No (개별) --> CUST_FORM[\"P-CUST-01-02: 개별 주문 폼 작성\"] :::userAction\n    CHECK_QTY -- Yes (대량 B2B) --> B2B_FORM[\"P-B2B-01-01: B2B 1:1 대량 견적 폼\"] :::userAction\n    B2B_PAGE --> B2B_FORM\n\n    CUST_FORM --> VALIDATE{\"입력값 & 배송지 유효성 검사\"} :::decision\n    B2B_FORM --> VALIDATE\n\n    VALIDATE -- Fail (오류) --> ERR_MSG[\"에러 표시 및 로고 파일 재첨부\"] :::errorModal\n    ERR_MSG --> B2B_FORM\n\n    VALIDATE -- Pass (성공) --> SYS_SAVE[\"시스템: 커스텀 옵션 & 견적 DB 저장\"] :::sysProcess\n    SYS_SAVE --> API_TALK[\"시스템: 카카오 알림톡 확정 발송\"] :::sysProcess\n    \n    API_TALK --> CONFIRM_PAGE[\"P-B2B-01-02: 견적/주문 접수 완료 팝업\"] :::userAction\n    \n    CONFIRM_PAGE --> END_EVENT([\"● 종료: 40년 장인 핸드크래프트 제작 시작\"]) :::startEnd\n"
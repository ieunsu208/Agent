"flowchart TD\n    classDef startEnd fill:#0F1A30,stroke:#0F1A30,stroke-width:2px,color:#FFF;\n    classDef userAction fill:#2C4370,stroke:#1D2E4E,stroke-width:2px,color:#FFF;\n    classDef sysProcess fill:#1B2A4A,stroke:#0F1A30,stroke-width:2px,color:#FFF;\n    classDef decision fill:#C5A059,stroke:#9E7B3B,stroke-width:2px,color:#000;\n    classDef errorModal fill:#8B261D,stroke:#6B1D16,stroke-width:2px,color:#FFF;\n\n    START([\"● 시작: 글로벌 랜딩 접속 (사단 익스프레스)\"]) :::startEnd\n    \n    START --> MAIN[\"P-MAIN-01: 메인 홈 탐색 & 통화 선택\"] :::userAction\n    \n    MAIN --> INTRO[\"P-INTRO-01: 멤버십 소개 & 웰컴 혜택\"] :::userAction\n    MAIN --> PLAN[\"P-PLAN-01: 구독 플랜 비교 (월간 vs 분기별)\"] :::userAction\n    MAIN --> CURA[\"P-CURA-01: 사계절 조향사 큐레이션\"] :::userAction\n    MAIN --> GLOB[\"P-GLOB-01: 전 세계 50개국 무료 배송 안내\"] :::userAction\n\n    INTRO --> COUPON[\"P-INTRO-01-01: 50% 웰컴 쿠폰 발급\"] :::userAction\n    PLAN --> JOIN[\"P-PLAN-01-01: 멤버십 1-Click 가입 모달\"] :::userAction\n    COUPON --> JOIN\n    CURA --> JOIN\n\n    JOIN --> VALIDATE{\"주소 & 카드 유효성 검사\"} :::decision\n\n    VALIDATE -- Fail (오류) --> ERR_MSG[\"에러 표시 & 입력값 재유도\"] :::errorModal\n    ERR_MSG --> JOIN\n\n    VALIDATE -- Pass (성공) --> SYS_SAVE[\"시스템: 멤버십 DB 저장 & 50% 쿠폰 적용\"] :::sysProcess\n    SYS_SAVE --> API_TALK[\"시스템: 카카오/이메일 알림톡 발송\"] :::sysProcess\n    \n    API_TALK --> CONFIRM_PAGE[\"P-PLAN-01-02: 가입 완료 & 배송 추적 팝업\"] :::userAction\n    \n    CONFIRM_PAGE --> END_EVENT([\"● 종료: 글로벌 익스프레스 정기 배송 시작\"]) :::startEnd\n"